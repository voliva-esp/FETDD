Bootstrap: docker
From: ubuntu:26.04

%post
    apt-get -y update
    apt-get install -y cmake build-essential libeigen3-dev graphviz libgraphviz-dev pybind11-dev
    apt-get install -y make build-essential libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev wget curl llvm libncursesw5-dev xz-utils tk-dev libffi-dev liblzma-dev git
    apt-get clean && rm -rf /var/lib/apt/lists/*

    # Define pyenv variables
    export PYENV_ROOT="/.pyenv"
    export PATH="$PYENV_ROOT/bin:$PATH"

    # Install pyenv
    curl https://pyenv.run | bash
    eval "$(pyenv init -)"

    # Install Python version
    pyenv install 3.8.20
    pyenv global 3.8.20
    rm -rf $PYENV_ROOT/sources/*

    # Create and activate virtual environment
    python -m venv .venv
    . .venv/bin/activate

    # Clone and checkout repository
    git clone https://github.com/voliva-esp/FETDD.git
    cd FETDD
    git checkout heisenberg_eswap_vqe

    # Upgrade pip and install packages using no-cache-dir
    export PIP_NO_CACHE_DIR=1
    python -m pip install --upgrade pip
    python -m pip install torch --index-url https://download.pytorch.org/whl/cpu
    pip install -r requirements.txt
    rm -rf /.pip-tmp

    cd source/cpp/
    mkdir build
    cd build
    cmake ..
    make
    cd ../../..

%environment
    export PYENV_ROOT="/.pyenv"
    export PATH="/.venv/bin:/.pyenv/shims:/.pyenv/bin:$PATH"
    export PYTHONPATH="/FETDD:$PYTHONPATH"

%runscript
    cd /FETDD
    python3 source/Test/testAll.py
    #python3 ./source/Exec/heisenberg_eswap_vqe_simple.py --qubits 10 --iterations 500
    #python3 ./source/Exec/heisenberg_eswap_vqe_simple.py --qubits 10 --iterations 500 --use-tdd True
    #python3 ./source/Exec/heisenberg_eswap_vqe_simple.py --qubits 12 --iterations 500
    #python3 ./source/Exec/heisenberg_eswap_vqe_simple.py --qubits 12 --iterations 500 --use-tdd True
    #python3 ./source/Exec/heisenberg_eswap_vqe_simple.py --qubits 14 --iterations 500
    #python3 ./source/Exec/heisenberg_eswap_vqe_simple.py --qubits 14 --iterations 500 --use-tdd True
    #python3 ./source/Exec/heisenberg_eswap_vqe_simple.py --qubits 16 --iterations 500
    #python3 ./source/Exec/heisenberg_eswap_vqe_simple.py --qubits 16 --iterations 500 --use-tdd True
    #python3 ./source/Exec/heisenberg_eswap_vqe_simple.py --qubits 18 --iterations 400
    #python3 ./source/Exec/heisenberg_eswap_vqe_simple.py --qubits 18 --iterations 400 --use-tdd True
    #python3 ./source/Exec/heisenberg_eswap_vqe_simple.py --qubits 20 --iterations 300
    #python3 ./source/Exec/heisenberg_eswap_vqe_simple.py --qubits 20 --iterations 300 --use-tdd True
    python3 ./source/Exec/heisenberg_eswap_vqe_simple.py --qubits 22 --iterations 200
    python3 ./source/Exec/heisenberg_eswap_vqe_simple.py --qubits 22 --iterations 200 --use-tdd True
